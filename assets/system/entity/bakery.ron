Entity((
    name: "bakery",
    kind: workbench,
    look: (
        sprite: "workbench",
        shadow: Heightmap(height: 0),
        scatter: (turn: none, mirror: false, offset_px: 0),
    ),
    health: 100,
    cost: Some({}),
    size: (3, 3),
    range: 30,
    output_range: 30,
    max_workers: 1,
    ticks_to_make: 50,
    makes: [
        "bread",
    ],
    on_spawn: [
